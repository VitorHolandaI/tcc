# ════════════════════════════════════════════════════════
# Keystroke Analysis Service - Environment Variables
# ════════════════════════════════════════════════════════

# Service Configuration
KEYSTROKE_SERVICE_HOST=0.0.0.0
KEYSTROKE_SERVICE_PORT=8005

# Database Configuration
DATABASE_URL=postgresql://testmaker:pass@localhost:5432/testmaker

# Firebase Configuration (JWT Validation)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccountKey.json

# Analysis Configuration
MAX_CONCURRENT_KEYSTROKE_ANALYSIS=5
MIN_EVENTS_THRESHOLD=10
